# ================================================================
# CariTalent Backend — Production Environment Template
# ================================================================
# CARA PAKAI:
#   1. Copy file ini sebagai .env di server Linux
#   2. Isi semua nilai yang bertanda: ← GANTI INI
#   3. Generate APP_KEY dengan: openssl rand -base64 32
#   4. JANGAN commit file .env ke git!
# ================================================================

APP_NAME=CariTalent
APP_ENV=production
APP_KEY=base64:                         # ← GANTI: output dari: openssl rand -base64 32
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP_OR_DOMAIN # ← GANTI: IP atau domain server kamu
APP_PORT=80                             # ← Port yang dibuka ke publik (80 atau 8000)

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                         # ← error di production (bukan debug)

# ================================================================
# DATABASE — PostgreSQL
# ================================================================
# DB_HOST dan DB_PORT TIDAK perlu diubah (menggunakan internal docker network)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=caritalent_db
DB_USERNAME=caritalent_user             # ← GANTI: username database
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT # ← GANTI: password kuat min 16 karakter

# ================================================================
# SESSION, QUEUE, CACHE
# ================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ================================================================
# MAIL (opsional — isi jika aplikasi kirim email)
# ================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@caritalent.com"
MAIL_FROM_NAME="${APP_NAME}"
